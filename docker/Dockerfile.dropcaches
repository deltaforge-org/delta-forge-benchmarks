# Privileged sidecar that drops the host OS page cache on demand.
#
# Audit surface: this entire image exists to do exactly one thing, write
# the byte "3" into /proc/sys/vm/drop_caches when a trigger is received.
# It does not run network listeners, does not execute user code, does not
# accept arbitrary commands. Read the ENTRYPOINT script and verify.
#
# Why a sidecar: the main bench container is unprivileged. Page-cache
# flushing requires CAP_SYS_ADMIN on the host. Isolating the privileged
# capability in this 10-line sidecar keeps the main container auditable.

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends socat coreutils \
    && rm -rf /var/lib/apt/lists/*

# Trigger handler: any connection to the Unix socket causes one drop_caches.
# socat reads a single byte (or EOF), then runs the handler. The handler
# reads no input and writes a fixed value to the host's drop_caches file.
COPY docker/dropcaches-handler.sh /usr/local/bin/dropcaches-handler.sh
RUN chmod +x /usr/local/bin/dropcaches-handler.sh

ENTRYPOINT ["/bin/sh", "-c", \
  "rm -f /run/dropcaches.sock && \
   exec socat UNIX-LISTEN:/run/dropcaches.sock,fork,reuseaddr,unlink-early SYSTEM:/usr/local/bin/dropcaches-handler.sh"]
