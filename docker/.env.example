# Copy this file to .env and adjust for your reference hardware.
# Both engines see exactly these resource limits, enforced by Docker.
#
# Public image: this stack pulls from `deltaforge/benchmarks:<TAG>` on Docker Hub
# by default. Set BENCH_IMAGE_TAG below to pin a specific release. Set
# BUILD_LOCAL=1 (and run `docker compose build`) to rebuild from this checkout.

# ---------- Container resources -----------------------------------------------

# CPU and memory caps. Both engines run inside the same container, but only
# one engine runs at a time, so whichever engine is active gets this full
# budget. Reviewers can verify by inspecting `docker stats` during a run.
BENCH_CPUS=8
BENCH_MEMORY=16g

# ---------- Workload ----------------------------------------------------------

# TPC-H scale factor. 1 = ~1 GB, 10 = ~10 GB. Larger values need more disk
# (parquet files persist under the bench_data volume).
BENCH_SCALE_FACTOR=1

# ---------- Image pinning -----------------------------------------------------

# When pulling the published image, this tag is what `docker compose up` fetches.
# Tagged releases follow the bench repo's CHANGELOG. `latest` floats; pin to
# a version (e.g. `v0.1.0`) for reproducible runs.
BENCH_IMAGE_TAG=latest

# Build args propagated to the Dockerfile. The published image bakes specific
# values; setting these only matters when you build the image locally.
PYSPARK_VERSION=4.0.0
DELTA_SPARK_VERSION=4.0.0
JDK_VERSION=17
POSTGRES_MAJOR=15

# Engine version pulled from the deltaforge-org public release. Used both
# at image-build time (downloads deltaforge-cli + deltaforge-compute tarballs
# from https://github.com/deltaforge-org/delta-forge/releases) and recorded
# in manifest.json at runtime. Set to a bare version string (no leading "v").
DF_VERSION=

# Engine commit. Resolved by the publish workflow from `git rev-parse HEAD`
# at v${DF_VERSION}. Recorded in image labels and manifest.json so reviewers
# can verify which engine commit they're benchmarking against.
DF_GIT_SHA=unset

# ---------- DeltaForge binary acquisition ------------------------------------

# BUILD_MODE controls how DF binaries are sourced at image-build time.
#   local   — copied from ./build/df-bins/ (run scripts/stage-local-bins.sh first)
#   release — downloaded from GitHub releases at DF_VERSION (for published images)
BUILD_MODE=local

# ---------- DeltaForge license -----------------------------------------------
# REQUIRED. DeltaForge cannot bootstrap without a license key — the headless
# bootstrap fails and the bench container exits. Sign up free (no credit card)
# at console.deltaforge.org and paste the key here. Passed as
# DELTA_FORGE_LICENSE_KEY to the headless bootstrap; the server activates
# online against the console on first container start, then caches the
# activation so subsequent runs work offline.
DELTA_FORGE_LICENSE_KEY=

# ---------- Delta Forge headless bootstrap ------------------------------------
# Source: delta-forge-bootstrap/src/inputs.rs:12-23
# The entrypoint sets DELTA_FORGE_DB_URL itself (postgres lifecycle is owned
# by the container). Only credentials and optional metadata are surfaced here.

DELTA_FORGE_ADMIN_PASSWORD=bench_admin_local
DELTA_FORGE_ENGINEER_PASSWORD=bench_engineer_local
DELTA_FORGE_ADMIN_EMAIL=admin@deltaforge.local
DELTA_FORGE_BIND_ADDR=127.0.0.1:3000

# ---------- Compute node registration (delta-forge-compute/src/bin/compute.rs) -------

NODE_SECRET=bench_node_local
NODE_ID=bench-local
DISPLAY_NAME=Bench Local

# ---------- Postgres (catalog DB; not the data path) --------------------------

PGPASSWORD=deltaforge_local

# ---------- Outputs -----------------------------------------------------------

# Where per-run artifacts go. Relative to the bench repo root, mounted into
# the container at /workspace/results.
BENCH_RESULTS_DIR=./results

# Privileged dropcaches sidecar trigger socket. If the host disallows
# privileged containers (or you skip the sidecar), runs are labeled
# `cold-os-cache=unverified` and excluded from cold-time aggregates.
DROPCACHES_SOCKET=/var/run/bench-dropcaches.sock
